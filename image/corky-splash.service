[Unit]
Description=Corky brand splash
Before=corky-bitcoind.service
DefaultDependencies=no
# sysinit.target orders after systemd-udevd: the SPI device node must
# exist before the ST7789 driver opens it.
After=sysinit.target local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/corky/corky/splash.py
RemainAfterExit=yes
User=root

[Install]
WantedBy=multi-user.target
